{{> component/styles}}
<main class="auth-page">
  <section class="auth-card">
    <p class="auth-realm">{{realmLabel}}</p>
    <h1>Sign in</h1>
    <p class="auth-note">Choose an account to continue.</p>
    <div class="auth-accounts">
      {{#each accounts}}
        <button class="auth-account" type="button" data-action="select-account" data-account="{{publicId}}"{{#if ../pending}} disabled{{/if}}>
          <span class="auth-account-name">{{name}}</span>
          {{#if username}}<span class="auth-account-username">{{username}}</span>{{/if}}
        </button>
      {{/each}}
    </div>
    {{#if error}}<p class="auth-error" role="alert">{{error}}</p>{{/if}}
    <div class="auth-actions">
      <button class="auth-link auth-back" type="button" data-action="different-account">Different account</button>
    </div>
  </section>
</main>
