{{> component/styles}}
<main class="auth-page">
  <section class="auth-card">
    <p class="auth-realm">{{realmLabel}}</p>
    <h1>Sign in</h1>
    {{#if reauth}}<p class="auth-note">Confirm your password to continue.</p>{{/if}}
    <p class="auth-identifier">{{identifier}}</p>
    <form data-form="password">
      {{> component/text-field id="password" name="password" label="Password" type="password" value=password autocomplete="current-password" disabled=pending invalid=invalid describedBy="password-error-message"}}
      {{#if allowLongSession}}
        <label class="auth-choice">
          <input type="checkbox" name="long_session"{{#if longSession}} checked{{/if}}{{#if pending}} disabled{{/if}}>
          <span>Keep me signed in</span>
        </label>
      {{/if}}
      {{#if error}}<p class="auth-error" id="password-error-message" role="alert">{{error}}</p>{{/if}}
      <div class="auth-actions">
        <button class="auth-link auth-back" type="button" data-action="back">Back</button>
        <button class="button" type="submit"{{#if passwordDisabled}} disabled{{/if}}>{{passwordLabel}}</button>
      </div>
    </form>
  </section>
</main>
