{{> component/styles}}
<main class="auth-page">
  <section class="auth-card auth-card-consent" aria-labelledby="consent-title">
    <h1 id="consent-title">Authorize {{clientName}}</h1>
    <p class="auth-note">{{clientName}} is requesting access to your {{realmName}} account.</p>

    <div class="auth-consent-account">
      <span class="auth-icon auth-icon-user" aria-hidden="true"></span>
      <span class="auth-consent-account-body">
        <span class="auth-consent-account-name">{{userName}}</span>
        <span class="auth-consent-account-meta">{{userMeta}}</span>
      </span>
      <button class="auth-link" type="button" data-action="different-consent-account"{{#if pending}} disabled{{/if}}>Not you?</button>
    </div>

    <p class="auth-consent-title">This will allow {{clientName}} to:</p>
    <ul class="auth-consent-scopes">
      {{#each scopes}}
        <li class="auth-consent-scope">
          <span class="auth-icon auth-icon-check" aria-hidden="true"></span>
          <span>{{description}}</span>
        </li>
      {{/each}}
    </ul>

    <p class="auth-consent-footer">You can revoke access at any time from your account settings.</p>
    {{#if error}}<p class="auth-error" role="alert">{{error}}</p>{{/if}}

    <div class="auth-actions">
      <button class="auth-link" type="button" data-action="deny-consent"{{#if pending}} disabled{{/if}}>Deny</button>
      <button class="button" type="button" data-action="allow-consent"{{#if pending}} disabled{{/if}}>{{consentLabel}}</button>
    </div>
  </section>
</main>
