<div class="auth-field">
  <input class="auth-input" id="{{id}}" name="{{name}}" type="{{type}}" value="{{value}}" placeholder=" " autocomplete="{{autocomplete}}"{{#if invalid}} aria-invalid="true" aria-describedby="{{describedBy}}"{{/if}}{{#if disabled}} disabled{{/if}}>
  <label for="{{id}}">{{label}}</label>
</div>
